# Copy this file to .env and put your Gemini API key here.
# Never commit .env to Git.

GEMINI_API_KEY=YOUR_API_KEY_HERE

# The project documentation references Gemini 3.8 Flash.
GEMINI_MODEL=gemini-3.8-flash

# false = lightweight default using Gemini for explanations.
# true = try the optional LaMini-Flan-T5 local explanation model first.
USE_LOCAL_EXPLAINER=false

# Optional when USE_LOCAL_EXPLAINER=true:
# LOCAL_EXPLAINER_MODEL=MBZUAI/LaMini-Flan-T5-783M
